using Gtk 4.0;
using Adw 1;

// Adw.AboutDialog is a final class and cannot be subclassed, so this is a plain
// object loaded through Gtk.Builder rather than a template. The version is
// filled in at runtime from the installed distribution.
Adw.AboutDialog about_dialog {
  application-name: "GTKPass";
  application-icon: "io.github.RonnyPfannschmidt.GTKPass";
  developer-name: _("GTKPass Contributors");
  website: "https://github.com/RonnyPfannschmidt/gtk-pass-ng";
  issue-url: "https://github.com/RonnyPfannschmidt/gtk-pass-ng/issues";
  license-type: mpl_2_0;
  copyright: "© 2025 GTKPass Contributors";
}
