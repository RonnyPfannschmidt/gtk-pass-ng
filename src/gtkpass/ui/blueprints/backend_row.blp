using Gtk 4.0;
using Adw 1;

// One row per configured backend instance. Every backend type's settings are
// declared here and the ones that do not apply are hidden, which keeps all
// widget construction declarative instead of branching in Python.
//
// Every path row carries a chooser button as well as its entry. Under Flatpak
// that is not a convenience: picking a directory through the file chooser is
// what grants the sandbox access to it, so a path typed in by hand is a store
// the application then cannot open.
template $BackendSettingsRow : Adw.ExpanderRow {
  [suffix]
  Button remove_button {
    icon-name: "user-trash-symbolic";
    valign: center;
    tooltip-text: _("Remove this backend");
    clicked => $_on_remove_clicked();

    styles ["destructive-action", "flat"]
  }

  Adw.EntryRow name_row {
    title: _("Name");
    changed => $_on_settings_changed();
  }

  // A demo.json, or the directory holding one; both are accepted, because the
  // setting has said "file" for long enough that either may be written there.
  Adw.EntryRow demo_path_row {
    title: _("Custom demo.json");
    visible: false;
    changed => $_on_settings_changed();

    [suffix]
    Button demo_path_button {
      icon-name: "document-open-symbolic";
      valign: center;
      tooltip-text: _("Choose a file");
      clicked => $_on_choose();

      styles ["flat"]
    }
  }

  Adw.EntryRow secretservice_collection_row {
    title: _("Keyring Collection");
    visible: false;
    changed => $_on_settings_changed();
  }

  Adw.EntryRow pass_store_row {
    title: _("Password Store Directory");
    visible: false;
    changed => $_on_settings_changed();

    [suffix]
    Button pass_store_button {
      icon-name: "folder-open-symbolic";
      valign: center;
      tooltip-text: _("Choose a folder");
      clicked => $_on_choose();

      styles ["flat"]
    }
  }

  Adw.SwitchRow pass_git_row {
    title: _("Offer to Sync");
    subtitle: _("Pull and push this store when it has a git remote");
    visible: false;
    notify::active => $_on_settings_changed();
  }

  Adw.EntryRow direct_store_row {
    title: _("Password Store Directory");
    visible: false;
    changed => $_on_settings_changed();

    [suffix]
    Button direct_store_button {
      icon-name: "folder-open-symbolic";
      valign: center;
      tooltip-text: _("Choose a folder");
      clicked => $_on_choose();

      styles ["flat"]
    }
  }

  Adw.EntryRow direct_gpg_home_row {
    title: _("GPG Home Directory");
    visible: false;
    changed => $_on_settings_changed();

    [suffix]
    Button direct_gpg_home_button {
      icon-name: "folder-open-symbolic";
      valign: center;
      tooltip-text: _("Choose a folder");
      clicked => $_on_choose();

      styles ["flat"]
    }
  }
}
