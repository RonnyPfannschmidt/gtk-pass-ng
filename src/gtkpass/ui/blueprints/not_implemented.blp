using Gtk 4.0;
using Adw 1;

// Placeholder shown by actions that have no implementation yet. Adw.AlertDialog
// is final, so this is a builder object rather than a template.
Adw.AlertDialog not_implemented_dialog {
  heading: _("Not Implemented Yet");
  body: _("Creating and editing passwords is not available in this build.");

  responses [
    ok: _("OK") suggested,
  ]

  default-response: "ok";
  close-response: "ok";
}
