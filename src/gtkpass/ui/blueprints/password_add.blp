using Gtk 4.0;
using Adw 1;

// New entry. Separate from password_edit.blp rather than one dialog in two
// modes: this one chooses a store and a name, which an edit must never offer,
// and an edit shows the entry it is replacing, which this has nothing to put
// in. The two overlap in the fields and in nothing else.
template $PasswordAddDialog : Adw.Dialog {
  title: _("New Password");
  content-width: 480;
  content-height: 620;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("Cancel");
        clicked => $_on_cancel();
      }

      [end]
      Button save_button {
        label: _("Add");
        clicked => $_on_save();

        styles ["suggested-action"]
      }
    }

    content: ScrolledWindow {
      vexpand: true;

      Adw.PreferencesPage {
        Adw.PreferencesGroup {
          // Shown only when more than one store can be written to: a choice of
          // one is not a choice, and asking for it would make the common case
          // longer for nothing.
          Adw.ComboRow backend_row {
            title: _("Store");
            visible: false;
          }

          Adw.EntryRow name_row {
            title: _("Name");
            changed => $_on_name_changed();
          }

          // Not an error label that appears and shifts the rows below it: the
          // row itself goes red and says why.
          Adw.PasswordEntryRow password_row {
            title: _("Password");

            [suffix]
            Button generate_button {
              icon-name: "system-run-symbolic";
              valign: center;
              tooltip-text: _("Generate a password");
              clicked => $_on_generate();

              styles ["flat"]
            }
          }
        }

        Adw.PreferencesGroup {
          title: _("Generated Passwords");

          Adw.SpinRow length_row {
            title: _("Length");

            adjustment: Adjustment {
              lower: 8;
              upper: 128;
              value: 20;
              step-increment: 1;
              page-increment: 8;
            };
          }

          Adw.SwitchRow symbols_row {
            title: _("Include Symbols");
            subtitle: _("Some sites refuse them");
            active: true;
          }
        }

        Adw.PreferencesGroup {
          title: _("Details");
          description: _("Everything below the password, stored as written.");

          ScrolledWindow {
            height-request: 140;

            TextView details_view {
              monospace: true;
              top-margin: 6;
              bottom-margin: 6;
              left-margin: 6;
              right-margin: 6;
            }

            styles ["card"]
          }
        }
      }
    };
  };
}
