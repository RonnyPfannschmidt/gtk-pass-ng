using Gtk 4.0;
using Adw 1;

// New entry. Separate from password_edit.blp rather than one dialog in two
// modes: this one chooses a store and a name, which an edit must never offer,
// and an edit shows the entry it is replacing, which this has nothing to put
// in. The two overlap in the fields and in nothing else.
template $PasswordAddDialog : Adw.Dialog {
  title: _("New Password");
  content-width: 480;
  // The same as the editor. 620 was taller than the window's default height,
  // and the details box at the bottom was what got cut off.
  content-height: 560;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("Cancel");
        clicked => $_on_cancel();
      }

      [end]
      Button save_button {
        label: _("Add");
        clicked => $_on_save();

        styles ["suggested-action"]
      }
    }

    content: ScrolledWindow {
      vexpand: true;

      Adw.PreferencesPage {
        Adw.PreferencesGroup {
          // Shown only when more than one store can be written to: a choice of
          // one is not a choice, and asking for it would make the common case
          // longer for nothing.
          Adw.ComboRow backend_row {
            title: _("Store");
            visible: false;
          }

          Adw.EntryRow name_row {
            title: _("Name");
            changed => $_on_name_changed();
          }

          // Not an error label that appears and shifts the rows below it: the
          // row itself goes red and says why.
          Adw.PasswordEntryRow password_row {
            title: _("Password");
          }
        }

        // The generator rows, shared with the edit dialog and the rotation
        // wizard. Its own Generate button sits with the scheme and the size
        // that decide what it makes, which is why there is no second one on
        // the field above.
        $PasswordGeneratorGroup generator {
          generated => $_on_generated();
        }

        Adw.PreferencesGroup {
          title: _("Details");
          description: _("Everything below the password, stored as written.");

          ScrolledWindow {
            height-request: 140;

            TextView details_view {
              monospace: true;
              top-margin: 6;
              bottom-margin: 6;
              left-margin: 6;
              right-margin: 6;
            }

            styles ["card"]
          }
        }
      }
    };
  };
}
