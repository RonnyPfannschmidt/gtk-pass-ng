using Gtk 4.0;
using Adw 1;

template $PasswordDetailView : Box {
  orientation: vertical;

  Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "loading";

      child: Box spinner_box {
        orientation: vertical;
        halign: center;
        valign: center;
        spacing: 12;
        vexpand: true;

        Spinner spinner {
          width-request: 48;
          height-request: 48;
        }

        Label spinner_label {
          label: _("Decrypting...");
        }
      };
    }

    StackPage {
      name: "content";

      child: ScrolledWindow content_scroll {
        vexpand: true;

        Adw.PreferencesPage prefs_page {
          Adw.PreferencesGroup info_group {
            title: _("Password Information");

            Adw.ActionRow name_row {
              title: _("Name");
              subtitle-selectable: true;
            }

            Adw.ActionRow username_row {
              title: _("Username");
              subtitle-selectable: true;

              [suffix]
              Button copy_username_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy username");
                clicked => $_on_copy_username();

                styles ["flat"]
              }
            }

            Adw.PasswordEntryRow password_row {
              title: _("Password");
              editable: false;

              [suffix]
              Button copy_password_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy password");
                clicked => $_on_copy_password();

                styles ["flat"]
              }
            }

            Adw.ActionRow url_row {
              title: _("URL");
              subtitle-selectable: true;

              [suffix]
              Button copy_url_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy URL");
                clicked => $_on_copy_url();

                styles ["flat"]
              }
            }
          }

          Adw.PreferencesGroup notes_group {
            title: _("Notes");

            Label notes_label {
              wrap: true;
              xalign: 0;
              selectable: true;
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 12;
              margin-end: 12;
            }
          }
        }
      };
    }
  }
}
