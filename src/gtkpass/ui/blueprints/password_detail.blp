using Gtk 4.0;
using Adw 1;

template $PasswordDetailView : Box {
  orientation: vertical;

  Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "loading";

      child: Box spinner_box {
        orientation: vertical;
        halign: center;
        valign: center;
        spacing: 12;
        vexpand: true;

        Spinner spinner {
          width-request: 48;
          height-request: 48;
        }

        Label spinner_label {
          label: _("Decrypting...");
        }
      };
    }

    StackPage {
      name: "content";

      child: ScrolledWindow content_scroll {
        vexpand: true;

        Adw.PreferencesPage prefs_page {
          // The entry names the pane rather than sitting in it as a field: a
          // row labelled "Name" whose value was the entry itself only pushed
          // the fields that matter further down. Folder and entry share a line
          // and read as one path; the folder is hidden for a top-level entry.
          //
          // Both sit on the baseline rather than centred, so the small dim
          // folder lines up with the foot of the large name instead of its
          // middle. The folder is what gives way when the pane is narrow: it
          // ellipsizes from the left, keeping the part nearest the entry.
          Adw.PreferencesGroup heading_group {
            Box {
              spacing: 2;
              baseline-position: bottom;

              Label path_label {
                ellipsize: start;
                visible: false;
                valign: baseline;

                styles ["dim-label"]
              }

              Label title_label {
                ellipsize: end;
                selectable: true;
                valign: baseline;

                // Selectable so the entry can be copied out of the heading,
                // but not focusable: as the first focusable widget on the page
                // it would otherwise open every entry with a text caret
                // blinking in the middle of its own title.
                can-focus: false;

                styles ["title-2"]
              }
            }
          }

          Adw.PreferencesGroup info_group {
            Adw.ActionRow username_row {
              title: _("Username");
              subtitle-selectable: true;

              [suffix]
              Button copy_username_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy username");
                clicked => $_on_copy_username();

                styles ["flat"]
              }
            }

            Adw.PasswordEntryRow password_row {
              title: _("Password");
              editable: false;

              [suffix]
              Button copy_password_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy password");
                clicked => $_on_copy_password();

                styles ["flat"]
              }
            }

            Adw.ActionRow url_row {
              title: _("URL");
              subtitle-selectable: true;

              [suffix]
              Button copy_url_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy URL");
                clicked => $_on_copy_url();

                styles ["flat"]
              }
            }
          }

          // Whatever else the store carries: host, port, account, and any key
          // this pane has no row of its own for. There is no fixed set of
          // them, so the rows come from a factory over a model rather than
          // from the template directly -- the same arrangement the sidebar
          // uses, and for the same reason: nothing may build a widget in
          // Python. The casts name the GType MetadataField registers.
          Adw.PreferencesGroup extras_group {
            title: _("Other Fields");

            ListView extras_view {
              show-separators: true;

              // A ListView takes the row separators from .boxed-list but not
              // the card around them -- that half of the style is written for
              // GtkListBox -- so .card supplies the border and the rounded
              // corners the group above it has.
              styles ["boxed-list", "card"]

              factory: BuilderListItemFactory {
                template ListItem {
                  child: Box {
                    orientation: vertical;
                    spacing: 2;
                    margin-top: 8;
                    margin-bottom: 8;
                    margin-start: 12;
                    margin-end: 12;

                    Label {
                      label: bind template.item as <$GTKPassMetadataField>.key;
                      xalign: 0;
                    }

                    Label {
                      label: bind template.item as <$GTKPassMetadataField>.value;
                      xalign: 0;
                      wrap: true;
                      selectable: true;
                      can-focus: false;

                      styles ["caption", "dim-label"]
                    }
                  };
                }
              };
            }
          }

          Adw.PreferencesGroup notes_group {
            title: _("Notes");

            Label notes_label {
              wrap: true;
              xalign: 0;
              selectable: true;
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 12;
              margin-end: 12;
            }
          }
        }
      };
    }
  }
}
