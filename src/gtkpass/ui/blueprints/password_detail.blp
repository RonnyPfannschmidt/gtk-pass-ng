using Gtk 4.0;
using Adw 1;

template $PasswordDetailView : Box {
  orientation: vertical;

  Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "loading";

      child: Box spinner_box {
        orientation: vertical;
        halign: center;
        valign: center;
        spacing: 12;
        vexpand: true;

        Spinner spinner {
          width-request: 48;
          height-request: 48;
        }

        Label spinner_label {
          label: _("Decrypting...");
        }
      };
    }

    StackPage {
      name: "content";

      // Two readings of the same entry. The pane divides an entry into
      // fields, notes and a password, and every one of those divisions is a
      // convention rather than a specification -- `pass` prescribes no format
      // below the first line. When a line is read the way its owner did not
      // mean it, the only way to see that used to be decrypting the file
      // outside the application.
      //
      // Adw.ViewSwitcher rather than the inline one, which arrived in
      // libadwaita 1.7 and this application supports 1.4. Fields is the
      // default because raw is for when the reading looks wrong, not the way
      // in.
      child: Adw.ToolbarView {
        [top]
        Adw.ViewSwitcher view_switcher {
          stack: view_stack;
          policy: wide;
          halign: center;
          margin-top: 6;
          margin-bottom: 6;
        }

        content: Adw.ViewStack view_stack {
          vexpand: true;

          Adw.ViewStackPage {
            name: "fields";
            title: _("Fields");
            icon-name: "view-list-symbolic";

            child: ScrolledWindow content_scroll {
              vexpand: true;

              Adw.PreferencesPage prefs_page {
          // The entry names the pane rather than sitting in it as a field: a
          // row labelled "Name" whose value was the entry itself only pushed
          // the fields that matter further down. Folder and entry share a line
          // and read as one path; the folder is hidden for a top-level entry.
          //
          // Both sit on the baseline rather than centred, so the small dim
          // folder lines up with the foot of the large name instead of its
          // middle. The folder is what gives way when the pane is narrow: it
          // ellipsizes from the left, keeping the part nearest the entry.
          Adw.PreferencesGroup heading_group {
            Box {
              orientation: vertical;
              spacing: 2;

              Box {
                spacing: 2;
                baseline-position: bottom;

                Label path_label {
                  ellipsize: start;
                  visible: false;
                  valign: baseline;

                  styles ["dim-label"]
                }

                Label title_label {
                  ellipsize: end;
                  selectable: true;
                  valign: baseline;

                  // Selectable so the entry can be copied out of the heading,
                  // but not focusable: as the first focusable widget on the
                  // page it would otherwise open every entry with a text
                  // caret blinking in the middle of its own title.
                  can-focus: false;

                  styles ["title-2"]
                }
              }

              // Which store the entry is in. With two configured, only the
              // sidebar said, and at narrow widths the sidebar is an overlay.
              Label store_label {
                xalign: 0;
                ellipsize: end;
                visible: false;

                styles ["dim-label", "caption"]
              }
            }
          }

          Adw.PreferencesGroup info_group {
            Adw.ActionRow username_row {
              title: _("Username");
              subtitle-selectable: true;

              [suffix]
              Button copy_username_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy username");
                clicked => $_on_copy_username();

                styles ["flat"]
              }
            }

            Adw.PasswordEntryRow password_row {
              title: _("Password");
              editable: false;

              [suffix]
              Button copy_password_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy password");
                clicked => $_on_copy_password();

                styles ["flat"]
              }
            }

            // The code an entry's otpauth:// line currently stands for.
            // The line itself stays below in Other Fields, dotted out: it is
            // the secret every future code comes from, and somebody moving to
            // another device needs to be able to get at it.
            //
            // Hidden for an entry that has no such line, which is most of
            // them, and shown carrying the reason when the line is there but
            // cannot produce codes -- an entry with a broken OTP line has a
            // problem its owner wants told rather than a row that never
            // appears.
            Adw.ActionRow otp_row {
              title: _("One-Time Code");
              subtitle-selectable: true;
              visible: false;

              // Seconds, not a progress bar: the number is what decides
              // whether to type this code or wait for the next one, and a bar
              // makes that judgement by eye.
              [suffix]
              Label otp_countdown_label {
                valign: center;
                width-chars: 3;
                xalign: 1;

                styles ["numeric", "dim-label"]
              }

              [suffix]
              Button copy_otp_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy one-time code");
                clicked => $_on_copy_otp();

                styles ["flat"]
              }
            }

            Adw.ActionRow url_row {
              title: _("URL");
              subtitle-selectable: true;

              // Only for a web address; anything else is shown and not
              // launched. The rotation wizard has had this all along, and
              // the pane is where people are when they want it.
              // libadwaita's own icon, the one its About dialog uses for a
              // link: shipped inside the library rather than by the icon
              // theme, which dropped external-link-symbolic.
              [suffix]
              Button open_url_btn {
                icon-name: "adw-external-link-symbolic";
                valign: center;
                visible: false;
                tooltip-text: _("Open in a browser");
                clicked => $_on_open_url();

                styles ["flat"]
              }

              [suffix]
              Button copy_url_btn {
                icon-name: "edit-copy-symbolic";
                valign: center;
                tooltip-text: _("Copy URL");
                clicked => $_on_copy_url();

                styles ["flat"]
              }
            }

            // From the listing rather than the entry: every backend reports
            // when a file last changed, and "how old is this password" is the
            // question behind most rotations. Hidden for a store that keeps
            // no time.
            Adw.ActionRow modified_row {
              title: _("Last Changed");
              visible: false;
            }
          }

          // Whatever else the store carries: host, port, account, and any key
          // this pane has no row of its own for. There is no fixed set of
          // them, so the rows come from a factory over a model rather than
          // from the template directly -- the same arrangement the sidebar
          // uses, and for the same reason: nothing may build a widget in
          // Python. The casts name the GType MetadataField registers.
          Adw.PreferencesGroup extras_group {
            title: _("Other Fields");

            // One control for all of them rather than one per row. A
            // BuilderListItemFactory template cannot connect a signal -- there
            // is no object to connect it to -- and action-target takes a
            // GVariant, which a string property cannot be bound to. So the
            // button lives here, where a handler works, and the rows follow it.
            header-suffix: ToggleButton reveal_extras_button {
              icon-name: "view-reveal-symbolic";
              tooltip-text: _("Show hidden fields");
              valign: center;
              visible: false;
              toggled => $_on_reveal_extras_toggled();

              styles ["flat"]
            };

            ListView extras_view {
              show-separators: true;

              // A ListView takes the row separators from .boxed-list but not
              // the card around them -- that half of the style is written for
              // GtkListBox -- so .card supplies the border and the rounded
              // corners the group above it has.
              styles ["boxed-list", "card"]

              factory: BuilderListItemFactory {
                template ListItem {
                  child: Box {
                    spacing: 6;
                    margin-top: 8;
                    margin-bottom: 8;
                    margin-start: 12;
                    margin-end: 12;

                    Box {
                      orientation: vertical;
                      spacing: 2;
                      hexpand: true;

                      Label {
                        label: bind template.item as <$GTKPassMetadataField>.key;
                        xalign: 0;
                      }

                      Label {
                        // display rather than value: a field that is itself a
                        // secret is dotted out until asked for.
                        label: bind template.item as <$GTKPassMetadataField>.display;
                        xalign: 0;
                        wrap: true;
                        selectable: true;
                        can-focus: false;

                        styles ["caption", "dim-label"]
                      }
                    }

                    // Copying is the one thing a dotted-out field cannot
                    // offer by being selectable, and it is what the field is
                    // there for.
                    //
                    // An action per row, named by the row's position, rather
                    // than one action taking the key as a parameter. A
                    // template cannot connect a signal, and a parameterised
                    // action needs its target bound -- which is null until
                    // the row is bound, and GTK's action helper warns about
                    // the mismatch twice per row while it is. A parameterless
                    // action named for the position has nothing to mismatch;
                    // _show_extra_fields registers one per field.
                    Button {
                      action-name: bind template.item as <$GTKPassMetadataField>.action;
                      icon-name: "edit-copy-symbolic";
                      valign: center;
                      tooltip-text: _("Copy this field");

                      styles ["flat"]
                    }
                  };
                }
              };
            }
          }

          Adw.PreferencesGroup notes_group {
            title: _("Notes");

            Label notes_label {
              wrap: true;
              xalign: 0;
              selectable: true;
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 12;
              margin-end: 12;
            }
          }
              }
            };
          }

          Adw.ViewStackPage {
            name: "raw";
            title: _("Raw");
            icon-name: "text-x-generic-symbolic";

            child: Box {
              orientation: vertical;
              spacing: 6;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              // Above the text rather than in the switcher bar, which would
              // have had to be shown and hidden per tab: the button belongs
              // to this page, so it lives on it.
              Box {
                halign: end;

                Button copy_raw_btn {
                  icon-name: "edit-copy-symbolic";
                  tooltip-text: _("Copy the whole entry");
                  clicked => $_on_copy_raw();

                  styles ["flat"]
                }
              }

              ScrolledWindow raw_scroll {
                vexpand: true;

                // A TextView rather than a Label: an entry can be long, the
                // text is selectable a line at a time, and monospace is what
                // makes a stray space at the end of a line visible -- which
                // is the kind of thing this tab exists to show.
                TextView raw_view {
                  editable: false;
                  monospace: true;
                  wrap-mode: word_char;
                  top-margin: 6;
                  bottom-margin: 6;
                  left-margin: 6;
                  right-margin: 6;

                  styles ["card"]
                }
              }
            };
          }
        };
      };
    }
  }
}
