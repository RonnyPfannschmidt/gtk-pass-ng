using Gtk 4.0;
using Adw 1;

template $PasswordEditDialog : Adw.Dialog {
  title: _("Edit Password");
  content-width: 480;
  content-height: 560;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("Cancel");
        clicked => $_on_cancel();
      }

      [end]
      Button save_button {
        label: _("Save");
        clicked => $_on_save();

        styles ["suggested-action"]
      }
    }

    content: ScrolledWindow {
      vexpand: true;

      Adw.PreferencesPage {
        Adw.PreferencesGroup {
          Adw.ActionRow name_row {
            title: _("Name");
            subtitle-selectable: true;
          }

          Adw.PasswordEntryRow password_row {
            title: _("Password");
          }

          // The two fields the pane has rows of its own for. Taken out of the
          // text below on the way in and put back on the way out, in the
          // place and the spelling they had, so a store written by another
          // tool is still readable by it.
          Adw.EntryRow username_row {
            title: _("Username");
          }

          Adw.EntryRow url_row {
            title: _("URL");
          }
        }

        // Rotating a password is an edit, and this is where an edit happens.
        // The generator used to be in the add dialog only -- which is the one
        // time a password is not being replaced.
        $PasswordGeneratorGroup generator {
          generated => $_on_generated();
        }

        Adw.PreferencesGroup {
          title: _("Details");
          description: _("Everything below the password, stored as written.");

          ScrolledWindow {
            height-request: 200;

            TextView details_view {
              monospace: true;
              top-margin: 6;
              bottom-margin: 6;
              left-margin: 6;
              right-margin: 6;
            }

            styles ["card"]
          }
        }
      }
    };
  };
}
