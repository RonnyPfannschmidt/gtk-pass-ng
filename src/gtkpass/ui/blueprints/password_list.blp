using Gtk 4.0;

template $PasswordTreeView : ScrolledWindow {
  vexpand: true;

  ColumnView column_view {
    show-row-separators: false;
    show-column-separators: false;

    ColumnViewColumn {
      title: _("Passwords");
      expand: true;

      // The row is declared here rather than built in a factory callback, so
      // the whole widget tree still lives in Blueprint. The casts have to name
      // the GType that PasswordNode registers.
      factory: BuilderListItemFactory {
        template ListItem {
          child: TreeExpander {
            list-row: bind template.item as <TreeListRow>;

            child: Box {
              spacing: 6;

              Image {
                icon-name: bind template.item as <TreeListRow>.item as <$GTKPassPasswordNode>.icon-name;
              }

              Label {
                label: bind template.item as <TreeListRow>.item as <$GTKPassPasswordNode>.name;
                xalign: 0;
                ellipsize: end;
              }
            };
          };
        }
      };
    }
  }
}
