using Gtk 4.0;

template $PasswordTreeView : ScrolledWindow {
  vexpand: true;

  ColumnView column_view {
    show-row-separators: false;
    show-column-separators: false;

    // A sidebar of names wants list density, not table density: this is the
    // style class that takes a row from 34 pixels down to 22. The header the
    // column would otherwise draw is hidden from PasswordTreeView, which has
    // no property to do it from here.
    styles ["data-table"]

    ColumnViewColumn {
      title: _("Passwords");
      expand: true;

      // The row is declared here rather than built in a factory callback, so
      // the whole widget tree still lives in Blueprint. The casts have to name
      // the GType that PasswordNode registers.
      factory: BuilderListItemFactory {
        template ListItem {
          child: TreeExpander {
            list-row: bind template.item as <TreeListRow>;

            child: Box {
              spacing: 6;

              // Empty for almost every row. A backend that would not load
              // carries the reason it gave here, which is the only place it
              // survives: the toast that also reports it has five seconds.
              tooltip-text: bind template.item as <TreeListRow>.item as <$GTKPassPasswordNode>.tooltip;

              Image {
                icon-name: bind template.item as <TreeListRow>.item as <$GTKPassPasswordNode>.icon-name;
              }

              Label {
                label: bind template.item as <TreeListRow>.item as <$GTKPassPasswordNode>.name;
                xalign: 0;
                ellipsize: end;
              }
            };
          };
        }
      };
    }
  }
}
