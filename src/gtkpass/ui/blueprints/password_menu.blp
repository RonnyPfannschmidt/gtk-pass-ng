using Gtk 4.0;

// The sidebar's context menu. A separate file rather than part of
// password_list.blp: that one holds a template, and GtkBuilder cannot load a
// file containing a <template> without the instance it belongs to, so an
// object declared beside it would be unreachable.
//
// Every item is a window action. The tree does not act on entries itself -- it
// reports a selection and the window decides -- and a menu that went through
// the widget would have had to grow a signal per item to say the same thing.
menu password_actions {
  section {
    item {
      label: _("Copy Password");
      action: "win.copy-password";
    }

    item {
      label: _("Copy Username");
      action: "win.copy-username";
    }
  }

  section {
    item {
      label: _("Edit");
      action: "win.edit-password";
    }

    item {
      label: _("Delete");
      action: "win.delete-password";
    }
  }
}

PopoverMenu password_menu {
  menu-model: password_actions;

  // Pointed at the row it was opened over rather than at the widget, so the
  // arrow would point at nothing in particular.
  has-arrow: false;
  halign: start;
}
