using Gtk 4.0;

// The sidebar's context menu. A separate file rather than part of
// password_list.blp: that one holds a template, and GtkBuilder cannot load a
// file containing a <template> without the instance it belongs to, so an
// object declared beside it would be unreachable.
//
// Every item is a window action. The tree does not act on entries itself -- it
// reports a selection and the window decides -- and a menu that went through
// the widget would have had to grow a signal per item to say the same thing.
// One menu per kind of row. A folder offered every entry action greyed out,
// which reads as broken rather than as not applicable, and a store row had
// nothing that was about the store.
menu entry_actions {
  section {
    item {
      label: _("Copy Password");
      action: "win.copy-password";
    }

    item {
      label: _("Copy Username");
      action: "win.copy-username";
    }

    item {
      label: _("Copy URL");
      action: "win.copy-url";
    }
  }

  section {
    // Prefilled with this entry's folder, which the add dialog reads off the
    // selection; the right-click that opened this menu made the selection.
    item {
      label: _("New Password Here");
      action: "win.add-password";
    }
  }

  section {
    item {
      label: _("Edit");
      action: "win.edit-password";
    }

    item {
      label: _("Rotate Password...");
      action: "win.rotate-password";
    }

    item {
      label: _("Rename or Move...");
      action: "win.rename-password";
    }

    item {
      label: _("Delete");
      action: "win.delete-password";
    }
  }
}

menu folder_actions {
  section {
    item {
      label: _("New Password Here");
      action: "win.add-password";
    }
  }

  section {
    item {
      label: _("Rename or Move Folder...");
      action: "win.rename-password";
    }
  }
}

menu store_actions {
  section {
    item {
      label: _("New Password Here");
      action: "win.add-password";
    }
  }

  section {
    item {
      label: _("Sync This Store");
      action: "win.sync-store";
    }

    item {
      label: _("Reload Stores");
      action: "win.reload";
    }
  }

  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }
  }
}

PopoverMenu password_menu {
  // Replaced per row before the menu is shown; this is the one it starts
  // with. Every item everywhere is a window or application action.
  menu-model: entry_actions;

  // Pointed at the row it was opened over rather than at the widget, so the
  // arrow would point at nothing in particular.
  has-arrow: false;
  halign: start;
}
