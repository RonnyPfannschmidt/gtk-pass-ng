using Gtk 4.0;
using Adw 1;

// Rotating a password, in the order that does not lose the account.
//
// Doing it through the editor writes the store first and the site second, and
// a site that refuses the new password -- too long, no symbols, a change form
// that fails -- leaves the store holding a password that does not work. The
// account is then reachable only through a reset.
//
// So the store is last. Three pages: make the replacement, put it into the
// site, say whether that worked. Until the third page is confirmed nothing is
// written, and the password that still works stays on the first page where it
// can be copied.
//
// A navigation view rather than a stack, because going back is the case this
// exists for: the site refused it, and the old password has to be reachable
// again.
template $PasswordRotateDialog : Adw.Dialog {
  title: _("Rotate Password");
  content-width: 520;
  content-height: 640;

  child: Adw.NavigationView navigation {

    Adw.NavigationPage {
      tag: "new";
      title: _("New Password");

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          [start]
          Button cancel_button {
            label: _("Cancel");
            clicked => $_on_cancel();
          }

          [end]
          Button to_site_button {
            label: _("Next");
            clicked => $_on_to_site();

            styles ["suggested-action"]
          }
        }

        content: ScrolledWindow {
          vexpand: true;

          Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Adw.ActionRow entry_row {
                title: _("Entry");
              }
            }

            Adw.PreferencesGroup {
              title: _("Now");
              description: _("Still the one that works. Nothing is written until the last page.");

              Adw.PasswordEntryRow current_row {
                title: _("Current Password");
                editable: false;

                [suffix]
                Button copy_current_button {
                  icon-name: "edit-copy-symbolic";
                  valign: center;
                  tooltip-text: _("Copy the current password");
                  clicked => $_on_copy_current();

                  styles ["flat"]
                }
              }
            }

            Adw.PreferencesGroup {
              title: _("Replacement");

              Adw.PasswordEntryRow new_row {
                title: _("New Password");

                [suffix]
                Button copy_new_button {
                  icon-name: "edit-copy-symbolic";
                  valign: center;
                  tooltip-text: _("Copy the new password");
                  clicked => $_on_copy_new();

                  styles ["flat"]
                }
              }
            }

            $PasswordGeneratorGroup generator {
              generated => $_on_generated();
            }
          }
        };
      };
    }

    Adw.NavigationPage {
      tag: "site";
      title: _("Change It There");

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          [end]
          Button to_confirm_button {
            label: _("Next");
            clicked => $_on_to_confirm();

            styles ["suggested-action"]
          }
        }

        content: ScrolledWindow {
          vexpand: true;

          Adw.PreferencesPage {
            Adw.PreferencesGroup {
              description: _("Change the password wherever it is used, then come back. The store still holds the old one until you say this worked.");

              // Hidden rather than shown empty when the entry has no such
              // field: a row with nothing in it reads as a field somebody
              // forgot to fill in.
              Adw.ActionRow url_row {
                title: _("Site");
                subtitle-selectable: true;

                [suffix]
                Button open_url_button {
                  icon-name: "adw-external-link-symbolic";
                  valign: center;
                  tooltip-text: _("Open in a browser");
                  clicked => $_on_open_url();

                  styles ["flat"]
                }
              }

              Adw.ActionRow username_row {
                title: _("Username");
                subtitle-selectable: true;

                [suffix]
                Button copy_username_button {
                  icon-name: "edit-copy-symbolic";
                  valign: center;
                  tooltip-text: _("Copy the username");
                  clicked => $_on_copy_username();

                  styles ["flat"]
                }
              }
            }

            Adw.PreferencesGroup {
              Adw.PasswordEntryRow site_new_row {
                title: _("New Password");
                editable: false;

                [suffix]
                Button copy_site_new_button {
                  icon-name: "edit-copy-symbolic";
                  valign: center;
                  tooltip-text: _("Copy the new password");
                  clicked => $_on_copy_new();

                  styles ["flat"]
                }
              }

              // A change form usually asks for the old one first, which is
              // why it is here as well as on the page before.
              Adw.PasswordEntryRow site_current_row {
                title: _("Current Password");
                editable: false;

                [suffix]
                Button copy_site_current_button {
                  icon-name: "edit-copy-symbolic";
                  valign: center;
                  tooltip-text: _("Copy the current password");
                  clicked => $_on_copy_current();

                  styles ["flat"]
                }
              }
            }
          }
        };
      };
    }

    Adw.NavigationPage {
      tag: "confirm";
      title: _("Did It Take?");

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          [end]
          Button save_button {
            label: _("Save to Store");
            clicked => $_on_save();

            styles ["suggested-action"]
          }
        }

        content: Adw.StatusPage {
          icon-name: "dialog-question-symbolic";
          title: _("Did the new password take?");
          description: _("Save it only if it did. If it did not, go back: the store still holds the password that works, and closing this changes nothing.");

          child: Box {
            orientation: vertical;
            halign: center;

            Label rotate_note {
              wrap: true;
              justify: center;
              max-width-chars: 44;

              styles ["dim-label"]
            }
          };
        };
      };
    }
  };
}
