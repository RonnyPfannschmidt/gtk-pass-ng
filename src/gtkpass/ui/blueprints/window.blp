using Gtk 4.0;
using Adw 1;

template $GTKPassWindow : Adw.ApplicationWindow {
  title: "GTKPass";
  default-width: 1000;
  default-height: 700;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      [start]
      Button add_button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add Password");
        action-name: "win.add-password";
      }

      // Insensitive until an entry is open; the action owns that.
      [start]
      Button edit_button {
        icon-name: "document-edit-symbolic";
        tooltip-text: _("Edit Password");
        action-name: "win.edit-password";
      }

      [end]
      MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
      }

      // Insensitive until a backend reports a store it can sync; the action
      // owns that. Packed after the menu so the menu stays outermost.
      [end]
      Button sync_button {
        tooltip-text: _("Sync with Remote");
        action-name: "win.sync";

        // A stack rather than swapping the child in Python: nothing here may
        // construct a widget, and a spinner has to replace the icon in place
        // so the header bar does not shift while a sync runs.
        child: Stack sync_stack {
          transition-type: crossfade;

          StackPage {
            name: "idle";

            child: Image {
              icon-name: "emblem-synchronizing-symbolic";
            };
          }

          StackPage {
            name: "busy";

            child: Adw.Spinner {};
          }
        };
      }
    }

    // Who a store is encrypted to has changed since it was last approved, so
    // writing to it is refused until somebody has looked. A banner rather than
    // a dialog: it has to stay on screen for as long as the refusal stands,
    // and reading the store is still perfectly fine meanwhile.
    [top]
    Adw.Banner recipient_banner {
      revealed: false;
      button-label: _("Review");
      button-clicked => $_on_review_recipients();
    }

    // Wraps the split view so toasts appear over the whole window, which is
    // the libadwaita convention.
    content: Adw.ToastOverlay toast_overlay {
      child: Adw.OverlaySplitView split_view {
        sidebar-position: start;
        show-sidebar: true;
        min-sidebar-width: 250;
        max-sidebar-width: 400;

        sidebar: Box {
          orientation: vertical;

          SearchEntry search_entry {
            placeholder-text: _("Search passwords...");
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;
          }

          $PasswordTreeView password_list {
            vexpand: true;
          }
        };

        content: Stack content_stack {
          transition-type: crossfade;

          StackPage {
            name: "placeholder";

            child: Adw.StatusPage placeholder_page {
              title: _("GTKPass");
              description: _("Loading...");
              icon-name: "dialog-password-symbolic";
              vexpand: true;

              // Only relevant when no backend is configured; shown on demand.
              child: Button open_preferences_button {
                label: _("Open Preferences");
                action-name: "app.preferences";
                halign: center;
                visible: false;

                styles ["suggested-action", "pill"]
              };
            };
          }

          StackPage {
            name: "detail";

            child: $PasswordDetailView password_detail {};
          }
        };
      };
    };
  }
}

menu primary_menu {
  section {
    item {
      label: _("Sync with Remote");
      action: "win.sync";
    }
  }
  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }
  }
  section {
    item {
      label: _("About GTKPass");
      action: "app.about";
    }
    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}
